zone "160.190.10.in-addr.arpa" IN {
        type master;
        file "/var/named/dynamic/nuvem.caixa.rzone";
        allow-update { key rndc-key; };
};



cat > /var/named/dynamic/rzone <<'EOF'
$TTL 86400
@       IN SOA  ns01.nuvem.caixa. root.nuvem.caixa. (
                2026070601 ; serial
                3600       ; refresh
                900        ; retry
                604800     ; expire
                86400 )    ; minimum

        IN NS   ns01.nuvem.caixa.
        IN NS   ns02.nuvem.caixa.

; PTRs
12      IN PTR  ns02.nuvem.caixa.
EOF




chown named:named /var/named/dynamic/rzone
chmod 640 /var/named/dynamic/rzone

named-checkconf /etc/named.conf
named-checkzone 160.190.10.in-addr.arpa /var/named/dynamic/rzone

systemctl restart named
systemctl status named --no-pager
